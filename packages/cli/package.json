{
	"name": "thermoworks",
	"version": "0.5.1",
	"description": "CLI for ThermoWorks Cloud - manage credentials, view temperatures, configure Copilot statusline",
	"type": "module",
	"bin": {
		"thermoworks": "./dist/index.js"
	},
	"files": [
		"dist/",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=18.0.0"
	},
	"license": "MIT",
	"author": "Jon Gallant",
	"repository": {
		"type": "git",
		"url": "https://github.com/jongio/thermoworks",
		"directory": "packages/cli"
	},
	"keywords": [
		"thermoworks",
		"thermometer",
		"temperature",
		"cli",
		"copilot",
		"statusline",
		"iot",
		"smoke",
		"signals"
	],
	"publishConfig": {
		"provenance": true,
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"prepack": "pnpm build",
		"clean": "rimraf dist"
	},
	"devDependencies": {
		"@types/node": "^26.0.1",
		"rimraf": "^6.1.3",
		"tsup": "^8.5.1",
		"vitest": "^4.1.9"
	},
	"dependencies": {
		"@github/keytar": "^7.10.6",
		"thermoworks-mcp": "workspace:^",
		"thermoworks-sdk": "workspace:^"
	}
}
