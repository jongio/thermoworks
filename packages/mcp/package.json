{
	"name": "thermoworks-mcp",
	"version": "0.1.0",
	"private": true,
	"description": "MCP server for ThermoWorks Cloud - internal library bundled into the thermoworks CLI (run via `thermoworks mcp start`)",
	"type": "module",
	"engines": {
		"node": ">=18.0.0"
	},
	"license": "MIT",
	"author": "Jon Gallant",
	"repository": {
		"type": "git",
		"url": "https://github.com/jongio/thermoworks",
		"directory": "packages/mcp"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"clean": "rimraf dist"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"rimraf": "^6.1.3",
		"tsup": "^8.5.1",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"thermoworks-sdk": "workspace:^",
		"zod": "^4.4.3"
	}
}
