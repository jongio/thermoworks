{
	"name": "thermoworks-mcp",
	"version": "0.1.0",
	"description": "MCP server for ThermoWorks Cloud - expose device data to AI assistants",
	"type": "module",
	"bin": {
		"thermoworks-mcp": "./dist/index.js"
	},
	"files": [
		"dist/",
		"README.md"
	],
	"engines": {
		"node": ">=18.0.0"
	},
	"license": "MIT",
	"author": "Jon Gallant",
	"repository": {
		"type": "git",
		"url": "https://github.com/jongio/thermoworks",
		"directory": "packages/mcp"
	},
	"keywords": [
		"thermoworks",
		"mcp",
		"model-context-protocol",
		"ai",
		"temperature",
		"iot"
	],
	"publishConfig": {
		"provenance": true,
		"access": "public"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsup",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"prepack": "pnpm build",
		"clean": "rimraf dist"
	},
	"devDependencies": {
		"@types/node": "^25.9.2",
		"tsup": "^8.5.1",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"thermoworks-sdk": "workspace:^",
		"zod": "^4.4.3"
	}
}
