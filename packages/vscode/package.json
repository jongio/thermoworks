{
  "name": "thermoworks",
  "private": true,
  "displayName": "ThermoWorks",
  "description": "Display real-time ThermoWorks device temperatures in the VS Code status bar",
  "version": "0.3.1",
  "publisher": "jongio",
  "author": "Jon Gallant",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jongio/thermoworks",
    "directory": "packages/vscode"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "thermoworks",
    "temperature",
    "thermometer",
    "iot",
    "status bar"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onView:thermoworksPanel",
    "onView:thermoworksEvents",
    "onCommand:thermoworks.login"
  ],
  "main": "./dist/extension.js",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "thermoworks",
          "title": "ThermoWorks",
          "icon": "images/fire.svg"
        }
      ]
    },
    "views": {
      "thermoworks": [
        {
          "id": "thermoworksPanel",
          "name": "Devices",
          "icon": "images/fire.svg"
        },
        {
          "id": "thermoworksEvents",
          "name": "Events",
          "icon": "images/fire.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "thermoworksPanel",
        "contents": "Sign in to ThermoWorks Cloud to view your devices and temperatures.\n[Sign In](command:thermoworks.signIn)\n\n[Open ThermoWorks Cloud](command:thermoworks.openCloud)",
        "when": "!thermoworks.isAuthenticated"
      },
      {
        "view": "thermoworksEvents",
        "contents": "Sign in to ThermoWorks Cloud to view events.\n[Sign In](command:thermoworks.signIn)",
        "when": "!thermoworks.isAuthenticated"
      }
    ],
    "commands": [
      {
        "command": "thermoworks.login",
        "title": "ThermoWorks: Login"
      },
      {
        "command": "thermoworks.logout",
        "title": "ThermoWorks: Logout"
      },
      {
        "command": "thermoworks.refresh",
        "title": "ThermoWorks: Refresh Temperatures"
      },
      {
        "command": "thermoworks.cycleNext",
        "title": "ThermoWorks: Cycle to Next Device"
      },
      {
        "command": "thermoworks.demo",
        "title": "ThermoWorks: Demo (Simulate Alarm)"
      },
      {
        "command": "thermoworks.signIn",
        "title": "ThermoWorks: Sign In"
      },
      {
        "command": "thermoworks.signOut",
        "title": "ThermoWorks: Sign Out"
      },
      {
        "command": "thermoworks.refreshPanel",
        "title": "ThermoWorks: Refresh Panel",
        "icon": "$(refresh)"
      },
      {
        "command": "thermoworks.openCloud",
        "title": "ThermoWorks: Open Cloud Dashboard",
        "icon": "$(link-external)"
      },
      {
        "command": "thermoworks.showEventDetails",
        "title": "ThermoWorks: Show Event Details"
      },
      {
        "command": "thermoworks.showArchiveDetails",
        "title": "ThermoWorks: Show Archive Details",
        "icon": "$(open-preview)"
      },
      {
        "command": "thermoworks.refreshArchives",
        "title": "ThermoWorks: Refresh Archives",
        "icon": "$(refresh)"
      },
      {
        "command": "thermoworks.configureAlarm",
        "title": "ThermoWorks: Configure Alarm"
      },
      {
        "command": "thermoworks.showTemperatureChart",
        "title": "ThermoWorks: Show Temperature Chart",
        "icon": "$(graph-line)"
      },
      {
        "command": "thermoworks.showArchiveChart",
        "title": "ThermoWorks: Show Session Chart",
        "icon": "$(graph-line)"
      },
      {
        "command": "thermoworks.startSession",
        "title": "ThermoWorks: Start Session",
        "icon": "$(record)"
      },
      {
        "command": "thermoworks.endSession",
        "title": "ThermoWorks: End Session",
        "icon": "$(debug-stop)"
      },
      {
        "command": "thermoworks.clearSession",
        "title": "ThermoWorks: Clear Session",
        "icon": "$(trash)"
      },
      {
        "command": "thermoworks.setAlarmInline",
        "title": "Set Alarm\u2026",
        "icon": "$(bell)"
      },
      {
        "command": "thermoworks.clearAlarmInline",
        "title": "Clear Alarm",
        "icon": "$(bell-slash)"
      },
      {
        "command": "thermoworks.refreshEvents",
        "title": "ThermoWorks: Refresh Events",
        "icon": "$(refresh)"
      },
      {
        "command": "thermoworks.filterEventsByDevice",
        "title": "ThermoWorks: Filter Events by Device",
        "icon": "$(filter)"
      },
      {
        "command": "thermoworks.clearEventsFilter",
        "title": "ThermoWorks: Show All Events",
        "icon": "$(clear-all)"
      },
      {
        "command": "thermoworks.setFanTarget",
        "title": "Set Fan Target\u2026",
        "icon": "$(flame)"
      },
      {
        "command": "thermoworks.setFanEnabled",
        "title": "Fan On/Off\u2026",
        "icon": "$(plug)"
      },
      {
        "command": "thermoworks.renameDevice",
        "title": "Rename Device\u2026",
        "icon": "$(edit)"
      },
      {
        "command": "thermoworks.resetMinMax",
        "title": "Reset Min/Max",
        "icon": "$(discard)"
      },
      {
        "command": "thermoworks.showTemperatureGuide",
        "title": "ThermoWorks: Temperature Guide",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "thermoworks.refreshPanel",
          "when": "view == thermoworksPanel && thermoworks.isAuthenticated",
          "group": "navigation"
        },
        {
          "command": "thermoworks.showTemperatureGuide",
          "when": "view == thermoworksPanel && thermoworks.isAuthenticated",
          "group": "navigation"
        },
        {
          "command": "thermoworks.openCloud",
          "when": "view == thermoworksPanel",
          "group": "navigation"
        },
        {
          "command": "thermoworks.refreshEvents",
          "when": "view == thermoworksEvents && thermoworks.isAuthenticated",
          "group": "navigation"
        },
        {
          "command": "thermoworks.clearEventsFilter",
          "when": "view == thermoworksEvents && thermoworks.isAuthenticated",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "thermoworks.signOut",
          "when": "view == thermoworksPanel && viewItem == account"
        },
        {
          "command": "thermoworks.refreshPanel",
          "when": "view == thermoworksPanel && viewItem == devicesFolder"
        },
        {
          "command": "thermoworks.showArchiveChart",
          "when": "view == thermoworksPanel && viewItem == archive",
          "group": "inline"
        },
        {
          "command": "thermoworks.showArchiveDetails",
          "when": "view == thermoworksPanel && viewItem == archive",
          "group": "inline"
        },
        {
          "command": "thermoworks.showTemperatureChart",
          "when": "view == thermoworksPanel && viewItem == device",
          "group": "inline"
        },
        {
          "command": "thermoworks.setAlarmInline",
          "when": "view == thermoworksPanel && viewItem == channelNode",
          "group": "inline"
        },
        {
          "command": "thermoworks.clearAlarmInline",
          "when": "view == thermoworksPanel && viewItem == channelNode",
          "group": "inline"
        },
        {
          "command": "thermoworks.filterEventsByDevice",
          "when": "view == thermoworksPanel && viewItem == device",
          "group": "inline"
        },
        {
          "command": "thermoworks.filterEventsByDevice",
          "when": "view == thermoworksPanel && viewItem == deviceWithFan",
          "group": "inline"
        },
        {
          "command": "thermoworks.showTemperatureChart",
          "when": "view == thermoworksPanel && viewItem == deviceWithFan",
          "group": "inline"
        },
        {
          "command": "thermoworks.renameDevice",
          "when": "view == thermoworksPanel && viewItem == device",
          "group": "inline"
        },
        {
          "command": "thermoworks.renameDevice",
          "when": "view == thermoworksPanel && viewItem == deviceWithFan",
          "group": "inline"
        },
        {
          "command": "thermoworks.setFanTarget",
          "when": "view == thermoworksPanel && viewItem == deviceWithFan",
          "group": "inline"
        },
        {
          "command": "thermoworks.setFanEnabled",
          "when": "view == thermoworksPanel && viewItem == deviceWithFan",
          "group": "inline"
        },
        {
          "command": "thermoworks.resetMinMax",
          "when": "view == thermoworksPanel && viewItem == channelNode",
          "group": "inline"
        },
        {
          "command": "thermoworks.clearSession",
          "when": "view == thermoworksPanel && viewItem == device",
          "group": "inline"
        },
        {
          "command": "thermoworks.clearSession",
          "when": "view == thermoworksPanel && viewItem == deviceWithFan",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "ThermoWorks",
      "properties": {
        "thermoworks.refreshInterval": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "description": "Temperature refresh interval in seconds (minimum 15)"
        },
        "thermoworks.statusBarMode": {
          "type": "string",
          "enum": [
            "single",
            "cycle",
            "all"
          ],
          "default": "single",
          "description": "Status bar display mode: 'single' shows the first device, 'cycle' rotates through devices, 'all' shows all devices compactly"
        },
        "thermoworks.cycleInterval": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Seconds between device rotations in cycle mode (minimum 1)"
        },
        "thermoworks.eventsLimit": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 500,
          "description": "Maximum number of events to display in the Events panel"
        },
        "thermoworks.archivesLimit": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 500,
          "description": "Maximum number of past sessions (archives) to list per device"
        },
        "thermoworks.notifications": {
          "type": "boolean",
          "default": true,
          "description": "Show desktop notifications when a temperature alarm triggers"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "build:webview": "vite build --config vite.webview.config.ts",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:@github/keytar --format=cjs --platform=node --sourcemap --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.125.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.0",
    "thermoworks-sdk": "workspace:^",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@github/keytar": "^7.10.6"
  }
}
