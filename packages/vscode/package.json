{
  "name": "thermoworks",
  "private": true,
  "displayName": "ThermoWorks",
  "description": "Monitor live ThermoWorks Cloud temperatures, alarms, charts, and events for your Smoke, Signals, Node, and RFX devices — right in the VS Code status bar and a full device panel.",
  "version": "0.6.0",
  "publisher": "jongio",
  "author": "Jon Gallant",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jongio/thermoworks",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/jongio/thermoworks/tree/main/packages/vscode#readme",
  "bugs": {
    "url": "https://github.com/jongio/thermoworks/issues"
  },
  "qna": "https://github.com/jongio/thermoworks/issues",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "thermoworks",
    "temperature",
    "thermometer",
    "bbq",
    "smoker",
    "grill",
    "cooking",
    "meat",
    "smoke",
    "signals",
    "node",
    "rfx",
    "iot",
    "alarm",
    "status bar",
    "mcp",
    "copilot"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onView:thermoworksPanel",
    "onView:thermoworksEvents",
    "onCommand:thermoworks.login"
  ],
  "main": "./dist/extension.js",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "thermoworks",
          "title": "ThermoWorks",
          "icon": "images/fire.svg"
        }
      ]
    },
    "views": {
      "thermoworks": [
        {
          "id": "thermoworksPanel",
          "name": "Devices",
          "icon": "images/fire.svg"
        },
        {
          "id": "thermoworksEvents",
          "name": "Events",
          "icon": "images/fire.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "thermoworksPanel",
        "contents": "Sign in to ThermoWorks Cloud to view your devices and temperatures.\n[Sign In](command:thermoworks.signIn)\n\n[Open ThermoWorks Cloud](command:thermoworks.openCloud)",
        "when": "!thermoworks.isAuthenticated"
      },
      {
        "view": "thermoworksEvents",
        "contents": "Sign in to ThermoWorks Cloud to view events.\n[Sign In](command:thermoworks.signIn)",
        "when": "!thermoworks.isAuthenticated"
      }
    ],
    "commands": [
      {
        "command": "thermoworks.login",
        "title": "ThermoWorks: Login"
      },
      {
        "command": "thermoworks.logout",
        "title": "ThermoWorks: Logout"
      },
      {
        "command": "thermoworks.refresh",
        "title": "Refresh Temperatures",
        "category": "ThermoWorks"
      },
      {
        "command": "thermoworks.cycleNext",
        "title": "Cycle to Next Device",
        "category": "ThermoWorks"
      },
      {
        "command": "thermoworks.demo",
        "title": "Demo (Simulate Alarm)",
        "category": "ThermoWorks"
      },
      {
        "command": "thermoworks.signIn",
        "title": "Sign In",
        "category": "ThermoWorks"
      },
      {
        "command": "thermoworks.signOut",
        "title": "Sign Out",
        "category": "ThermoWorks"
      },
      {
        "command": "thermoworks.refreshPanel",
        "title": "Refresh Panel",
        "category": "ThermoWorks",
        "icon": "$(refresh)"
      },
      {
        "command": "thermoworks.toggleDeviceView",
        "title": "Toggle Grouped/List View",
        "category": "ThermoWorks",
        "icon": "$(list-tree)"
      },
      {
        "command": "thermoworks.openCloud",
        "title": "Open Cloud Dashboard",
        "category": "ThermoWorks",
        "icon": "$(link-external)"
      },
      {
        "command": "thermoworks.showEventDetails",
        "title": "Show Event Details",
        "category": "ThermoWorks"
      },
      {
        "command": "thermoworks.showArchiveDetails",
        "title": "Show Archive Details",
        "category": "ThermoWorks",
        "icon": "$(open-preview)"
      },
      {
        "command": "thermoworks.refreshArchives",
        "title": "Refresh Archives",
        "category": "ThermoWorks",
        "icon": "$(refresh)"
      },
      {
        "command": "thermoworks.configureAlarm",
        "title": "Configure Alarm",
        "category": "ThermoWorks"
      },
      {
        "command": "thermoworks.showTemperatureChart",
        "title": "Show Temperature Chart",
        "category": "ThermoWorks",
        "icon": "$(graph-line)"
      },
      {
        "command": "thermoworks.showArchiveChart",
        "title": "Show Session Chart",
        "category": "ThermoWorks",
        "icon": "$(graph-line)"
      },
      {
        "command": "thermoworks.startSession",
        "title": "Start Session",
        "category": "ThermoWorks",
        "icon": "$(record)"
      },
      {
        "command": "thermoworks.endSession",
        "title": "End Session",
        "category": "ThermoWorks",
        "icon": "$(debug-stop)"
      },
      {
        "command": "thermoworks.clearSession",
        "title": "Clear Session",
        "category": "ThermoWorks",
        "icon": "$(trash)"
      },
      {
        "command": "thermoworks.setAlarmInline",
        "title": "Set Alarm…",
        "icon": "$(bell)"
      },
      {
        "command": "thermoworks.clearAlarmInline",
        "title": "Clear Alarm",
        "icon": "$(bell-slash)"
      },
      {
        "command": "thermoworks.refreshEvents",
        "title": "Refresh Events",
        "category": "ThermoWorks",
        "icon": "$(refresh)"
      },
      {
        "command": "thermoworks.filterEventsByDevice",
        "title": "Filter Events by Device",
        "category": "ThermoWorks",
        "icon": "$(filter)"
      },
      {
        "command": "thermoworks.clearEventsFilter",
        "title": "Show All Events",
        "category": "ThermoWorks",
        "icon": "$(list-flat)"
      },
      {
        "command": "thermoworks.setFanTarget",
        "title": "Set Target Temp…",
        "icon": "$(dashboard)"
      },
      {
        "command": "thermoworks.setFanEnabled",
        "title": "Fan On/Off…",
        "icon": "$(plug)"
      },
      {
        "command": "thermoworks.renameDevice",
        "title": "Rename Device…",
        "icon": "$(edit)"
      },
      {
        "command": "thermoworks.resetMinMax",
        "title": "Reset Min/Max",
        "icon": "$(discard)"
      },
      {
        "command": "thermoworks.showTemperatureGuide",
        "title": "Temperature Guide",
        "category": "ThermoWorks",
        "icon": "$(book)"
      },
      {
        "command": "thermoworks.addToGroup",
        "title": "Add to Group…",
        "category": "ThermoWorks",
        "icon": "$(add)"
      },
      {
        "command": "thermoworks.removeFromGroup",
        "title": "Remove from Group",
        "category": "ThermoWorks",
        "icon": "$(remove)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "thermoworks.refreshPanel",
          "when": "view == thermoworksPanel && thermoworks.isAuthenticated",
          "group": "navigation"
        },
        {
          "command": "thermoworks.showTemperatureGuide",
          "when": "view == thermoworksPanel && thermoworks.isAuthenticated",
          "group": "navigation"
        },
        {
          "command": "thermoworks.openCloud",
          "when": "view == thermoworksPanel",
          "group": "navigation"
        },
        {
          "command": "thermoworks.refreshEvents",
          "when": "view == thermoworksEvents && thermoworks.isAuthenticated",
          "group": "navigation"
        },
        {
          "command": "thermoworks.clearEventsFilter",
          "when": "view == thermoworksEvents && thermoworks.isAuthenticated",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "thermoworks.signOut",
          "when": "view == thermoworksPanel && viewItem == account"
        },
        {
          "command": "thermoworks.toggleDeviceView",
          "when": "view == thermoworksPanel && viewItem == devicesFolder",
          "group": "inline"
        },
        {
          "command": "thermoworks.refreshPanel",
          "when": "view == thermoworksPanel && viewItem == devicesFolder"
        },
        {
          "command": "thermoworks.showArchiveChart",
          "when": "view == thermoworksPanel && viewItem == archive",
          "group": "inline"
        },
        {
          "command": "thermoworks.showArchiveDetails",
          "when": "view == thermoworksPanel && viewItem == archive",
          "group": "inline"
        },
        {
          "command": "thermoworks.showTemperatureChart",
          "when": "view == thermoworksPanel && viewItem =~ /^device(WithFan)?$/",
          "group": "inline"
        },
        {
          "command": "thermoworks.filterEventsByDevice",
          "when": "view == thermoworksPanel && viewItem =~ /^device(WithFan)?$/",
          "group": "inline"
        },
        {
          "command": "thermoworks.setAlarmInline",
          "when": "view == thermoworksPanel && viewItem == channelNode",
          "group": "inline"
        },
        {
          "command": "thermoworks.clearAlarmInline",
          "when": "view == thermoworksPanel && viewItem == channelNode",
          "group": "inline"
        },
        {
          "command": "thermoworks.resetMinMax",
          "when": "view == thermoworksPanel && viewItem == channelNode",
          "group": "inline"
        },
        {
          "command": "thermoworks.renameDevice",
          "when": "view == thermoworksPanel && viewItem =~ /^device(WithFan)?$/",
          "group": "inline"
        },
        {
          "command": "thermoworks.setFanTarget",
          "when": "view == thermoworksPanel && viewItem == deviceWithFan",
          "group": "inline"
        },
        {
          "command": "thermoworks.setFanEnabled",
          "when": "view == thermoworksPanel && viewItem == deviceWithFan",
          "group": "inline"
        },
        {
          "command": "thermoworks.setFanTarget",
          "when": "view == thermoworksPanel && viewItem == fanDetail",
          "group": "inline"
        },
        {
          "command": "thermoworks.setFanEnabled",
          "when": "view == thermoworksPanel && viewItem == fanDetail",
          "group": "inline"
        },
        {
          "command": "thermoworks.clearSession",
          "when": "view == thermoworksPanel && viewItem =~ /^device(WithFan)?$/",
          "group": "inline"
        },
        {
          "command": "thermoworks.showTemperatureChart",
          "when": "view == thermoworksPanel && viewItem =~ /^device(WithFan)?$/",
          "group": "1_view"
        },
        {
          "command": "thermoworks.filterEventsByDevice",
          "when": "view == thermoworksPanel && viewItem =~ /^device(WithFan)?$/",
          "group": "1_view"
        },
        {
          "command": "thermoworks.renameDevice",
          "when": "view == thermoworksPanel && viewItem =~ /^device(WithFan)?$/",
          "group": "2_edit"
        },
        {
          "command": "thermoworks.clearSession",
          "when": "view == thermoworksPanel && viewItem =~ /^device(WithFan)?$/",
          "group": "2_edit"
        },
        {
          "command": "thermoworks.setFanTarget",
          "when": "view == thermoworksPanel && viewItem == deviceWithFan",
          "group": "3_fan"
        },
        {
          "command": "thermoworks.setFanEnabled",
          "when": "view == thermoworksPanel && viewItem == deviceWithFan",
          "group": "3_fan"
        },
        {
          "command": "thermoworks.setAlarmInline",
          "when": "view == thermoworksPanel && viewItem == channelNode",
          "group": "1_alarm"
        },
        {
          "command": "thermoworks.clearAlarmInline",
          "when": "view == thermoworksPanel && viewItem == channelNode",
          "group": "1_alarm"
        },
        {
          "command": "thermoworks.resetMinMax",
          "when": "view == thermoworksPanel && viewItem == channelNode",
          "group": "2_reset"
        },
        {
          "command": "thermoworks.addToGroup",
          "when": "view == thermoworksPanel && viewItem =~ /^device(WithFan)?$/",
          "group": "4_group"
        },
        {
          "command": "thermoworks.removeFromGroup",
          "when": "view == thermoworksPanel && viewItem =~ /^device(WithFan)?$/ && thermoworks.groupedView",
          "group": "4_group"
        }
      ]
    },
    "configuration": {
      "title": "ThermoWorks",
      "properties": {
        "thermoworks.refreshInterval": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "description": "Temperature refresh interval in seconds (minimum 15)"
        },
        "thermoworks.statusBarMode": {
          "type": "string",
          "enum": [
            "single",
            "cycle",
            "all"
          ],
          "default": "single",
          "description": "Status bar display mode: 'single' shows the first device, 'cycle' rotates through devices, 'all' shows all devices compactly"
        },
        "thermoworks.cycleInterval": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Seconds between device rotations in cycle mode (minimum 1)"
        },
        "thermoworks.eventsLimit": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 500,
          "description": "Maximum number of events to display in the Events panel"
        },
        "thermoworks.archivesLimit": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 500,
          "description": "Maximum number of past sessions (archives) to list per device"
        },
        "thermoworks.notifications": {
          "type": "boolean",
          "default": true,
          "description": "Show desktop notifications when a temperature alarm triggers"
        },
        "thermoworks.defaultDevice": {
          "type": "string",
          "default": "",
          "description": "Preferred device for status bar in 'single' mode (match by serial or label, case-insensitive)"
        },
        "thermoworks.streaming": {
          "type": "boolean",
          "default": true,
          "description": "Enable live WebSocket streaming for real-time updates. When false, only interval-based polling is used."
        },
        "thermoworks.units": {
          "type": "string",
          "enum": [
            "auto",
            "F",
            "C"
          ],
          "default": "auto",
          "description": "Temperature display units: 'auto' uses the device's native units, 'F' converts to Fahrenheit, 'C' converts to Celsius"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "thermoworks.gettingStarted",
        "title": "Getting Started with ThermoWorks",
        "description": "Connect your ThermoWorks devices to VS Code in a few steps.",
        "steps": [
          {
            "id": "thermoworks.walkthrough.signIn",
            "title": "Sign in to ThermoWorks Cloud",
            "description": "Sign in with your ThermoWorks Cloud account to access your devices.\n\n[Sign In](command:thermoworks.signIn)",
            "media": {
              "image": "images/icon.png",
              "altText": "ThermoWorks logo"
            },
            "completionEvents": [
              "onCommand:thermoworks.signIn"
            ]
          },
          {
            "id": "thermoworks.walkthrough.devices",
            "title": "Find your devices in the tree",
            "description": "Open the ThermoWorks panel in the activity bar to see all your connected devices, channels, and battery status.\n\n[Open Devices Panel](command:thermoworksPanel.focus)",
            "media": {
              "image": "images/icon.png",
              "altText": "ThermoWorks devices panel"
            },
            "completionEvents": [
              "onView:thermoworksPanel"
            ]
          },
          {
            "id": "thermoworks.walkthrough.alarm",
            "title": "Set an alarm on a channel",
            "description": "Right-click any channel in the Devices panel and choose **Set Alarm** to configure high/low temperature thresholds.\n\n[Configure Alarm](command:thermoworks.configureAlarm)",
            "media": {
              "image": "images/icon.png",
              "altText": "Configure alarm thresholds"
            },
            "completionEvents": [
              "onCommand:thermoworks.configureAlarm"
            ]
          },
          {
            "id": "thermoworks.walkthrough.chart",
            "title": "Open a temperature chart",
            "description": "Click the chart icon on any device to see a live temperature graph with alarm threshold lines.\n\n[Show Chart](command:thermoworks.showTemperatureChart)",
            "media": {
              "image": "images/icon.png",
              "altText": "Live temperature chart"
            },
            "completionEvents": [
              "onCommand:thermoworks.showTemperatureChart"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "build:webview": "vite build --config vite.webview.config.ts",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:@github/keytar --format=cjs --platform=node --sourcemap --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.125.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2",
    "thermoworks-sdk": "workspace:^",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@github/keytar": "^7.10.6"
  }
}
